# Local development values. Copy this file to .env and edit it.
FRONTEND_URL=http://localhost:5173

# Replace this development-only secret before any deployment.
JWT_SECRET=VHJpcGlsb3QtZGV2ZWxvcG1lbnQtc2VjcmV0LWtleS1tdXN0LWJlLXJlcGxhY2VkLWZvci1wcm9kdWN0aW9uLW9ubHk=
JWT_EXPIRATION_MINUTES=1440

# Google OAuth2. Set enabled=true after configuring a Google Web OAuth client.
GOOGLE_OAUTH_ENABLED=false
GOOGLE_CLIENT_ID=local-dev-client-id
GOOGLE_CLIENT_SECRET=local-dev-client-secret

# Optional Gemini API key. Get one from Google AI Studio.
GEMINI_API_KEY=API_KEY
GEMINI_MODEL=gemini-3.8-flash

# H2 is the default. Override these to use PostgreSQL.
DB_URL=jdbc:h2:file:./data/tripilot;AUTO_SERVER=TRUE
DB_DRIVER=org.h2.Driver
DB_USERNAME=sa
DB_PASSWORD=
